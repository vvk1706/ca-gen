<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.dlis</groupId>
    <artifactId>dlis-modernisation-liberty</artifactId>
    <version>2.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>dlis-candidate-svc</artifactId>
  <packaging>war</packaging>
  <name>DLIS Candidate Service (Liberty)</name>

  <dependencies>
    <dependency>
      <groupId>com.dlis</groupId>
      <artifactId>dlis-common</artifactId>
    </dependency>

    <!-- Jakarta EE 10 Web Profile API (CDI, JAX-RS, JSON-B/P, etc.) -->
    <dependency>
      <groupId>jakarta.platform</groupId>
      <artifactId>jakarta.jakartaee-web-api</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- MicroProfile 6.1 (Config, Health, OpenAPI, RestClient, FaultTolerance) -->
    <dependency>
      <groupId>org.eclipse.microprofile</groupId>
      <artifactId>microprofile</artifactId>
      <type>pom</type>
      <scope>provided</scope>
    </dependency>

    <!-- DB2 Driver for testing/runtime compile references if needed -->
    <dependency>
      <groupId>com.ibm.db2</groupId>
      <artifactId>jcc</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- Test dependencies -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <version>${mockito.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>dlis-candidate-svc</finalName>
    <plugins>
      <plugin>
        <groupId>io.openliberty.tools</groupId>
        <artifactId>liberty-maven-plugin</artifactId>
        <configuration>
          <serverName>candidateServer</serverName>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
