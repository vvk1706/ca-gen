*================================================================*
* CA Gen Action Block
* Name    : AB-RECORD-APPROVAL-1
* Process : PROC-VALIDATE-AUTHORITY1-USER / PROC-RECORD-APPROVAL1 /
*           PROC-NOTIFY-REJECTION-AUTH1
* Desc    : Records the first authority approval or rejection.
*           Rules:
*             - Approver must be active and authorised for level 1
*             - Approver must be authorised for the license type
*             - Payment must already be completed
*================================================================*

ACTION-BLOCK: AB-RECORD-APPROVAL-1
  IMPORTS:
    WS-APPLICATION-ID            NUMERIC(10)
    WS-AUTHORITY-USER-CODE       CHARACTER(20)
    WS-DECISION                  CHARACTER(1)     * A=Approve, R=Reject
    WS-DECISION-NOTES            CHARACTER(200)

  EXPORTS:
    WS-RETURN-CODE               NUMERIC(4)       * 0=OK, 1=App Not Found, 2=Auth Not Found,
                                                  * 3=Not Authorised, 4=Payment Not Done,
                                                  * 5=Invalid Decision, 99=Error
    WS-RETURN-MSG                CHARACTER(100)

  LOCAL-VIEWS:
    LV-APPLICATION               VAPPLICATION-ALL
    LV-AUTHORITY                 VAUTHORITY-LOOKUP
    LV-APP-UPDATE                VAPPLICATION-APPROVAL1-UPD

  ACTION-DIAGRAM:
    MOVE 0 TO WS-RETURN-CODE
    MOVE SPACES TO WS-RETURN-MSG

    * ------- Validate decision value -------
    IF WS-DECISION NOT IN ('A', 'R')
      MOVE 5 TO WS-RETURN-CODE
      MOVE 'DECISION MUST BE A=APPROVE OR R=REJECT' TO WS-RETURN-MSG
      ESCAPE
    END-IF

    * ------- Read application -------
    READ LV-APPLICATION
      WHERE LV-APPLICATION.APPLICATION-ID = WS-APPLICATION-ID
      WHEN NONE
        MOVE 1 TO WS-RETURN-CODE
        MOVE 'APPLICATION NOT FOUND' TO WS-RETURN-MSG
        ESCAPE
    END-READ

    * ------- Check payment is complete -------
    IF LV-APPLICATION.PAYMENT-STATUS <> 'P'
      MOVE 4 TO WS-RETURN-CODE
      MOVE 'PAYMENT MUST BE COMPLETED BEFORE FIRST APPROVAL' TO WS-RETURN-MSG
      ESCAPE
    END-IF

    * ------- Validate authority user -------
    READ LV-AUTHORITY
      WHERE LV-AUTHORITY.USER-CODE       = WS-AUTHORITY-USER-CODE
      AND   LV-AUTHORITY.AUTHORITY-LEVEL = '1'
      AND   LV-AUTHORITY.ACTIVE-STATUS   = 'A'
      WHEN NONE
        MOVE 2 TO WS-RETURN-CODE
        MOVE 'AUTHORITY USER NOT FOUND OR NOT ACTIVE AT LEVEL 1' TO WS-RETURN-MSG
        ESCAPE
    END-READ

    * ------- Check authorised for license type -------
    IF LV-APPLICATION.LICENSE-TYPE NOT IN LV-AUTHORITY.LICENSE-TYPES-AUTHORISED
      MOVE 3 TO WS-RETURN-CODE
      MOVE 'AUTHORITY USER IS NOT AUTHORISED FOR THIS LICENSE TYPE' TO WS-RETURN-MSG
      ESCAPE
    END-IF

    * ------- Record approval 1 decision -------
    CHANGE LV-APP-UPDATE
      WHERE LV-APP-UPDATE.APPLICATION-ID = WS-APPLICATION-ID
        MOVE WS-DECISION              TO LV-APP-UPDATE.APPROVAL-1-STATUS
        MOVE LV-AUTHORITY.AUTHORITY-NAME TO LV-APP-UPDATE.APPROVAL-1-AUTHORITY
        MOVE CURRENT-DATE             TO LV-APP-UPDATE.APPROVAL-1-DATE
        MOVE WS-DECISION-NOTES        TO LV-APP-UPDATE.APPROVAL-1-NOTES
        IF WS-DECISION = 'A'
          MOVE 'A2' TO LV-APP-UPDATE.APPLICATION-STATUS
        ELSE
          MOVE 'RE' TO LV-APP-UPDATE.APPLICATION-STATUS
        END-IF
        MOVE CURRENT-DATE             TO LV-APP-UPDATE.LAST-UPDATED-DATE
        MOVE WS-AUTHORITY-USER-CODE   TO LV-APP-UPDATE.LAST-UPDATED-BY
    END-CHANGE

    MOVE 0 TO WS-RETURN-CODE
    IF WS-DECISION = 'A'
      MOVE 'FIRST APPROVAL RECORDED - APPLICATION FORWARDED FOR SECOND APPROVAL'
        TO WS-RETURN-MSG
    ELSE
      MOVE 'FIRST APPROVAL REJECTED - APPLICATION CLOSED' TO WS-RETURN-MSG
    END-IF

END-ACTION-BLOCK
