*================================================================*
* CA Gen Action Block
* Name    : AB-CREATE-CANDIDATE
* Process : PROC-CREATE-CANDIDATE
* Desc    : Validate and create a new candidate record
*================================================================*

ACTION-BLOCK: AB-CREATE-CANDIDATE
  IMPORTS:
    WS-FIRST-NAME                CHARACTER(30)
    WS-LAST-NAME                 CHARACTER(30)
    WS-DATE-OF-BIRTH             DATE
    WS-ID-NUMBER                 CHARACTER(20)
    WS-ADDRESS-LINE-1            CHARACTER(50)
    WS-ADDRESS-LINE-2            CHARACTER(50)
    WS-CITY                      CHARACTER(30)
    WS-STATE-PROVINCE            CHARACTER(30)
    WS-POSTAL-CODE               CHARACTER(10)
    WS-COUNTRY                   CHARACTER(30)
    WS-PHONE-NUMBER              CHARACTER(15)
    WS-EMAIL-ADDRESS             CHARACTER(60)
    WS-CREATED-BY                CHARACTER(20)

  EXPORTS:
    WS-CANDIDATE-ID              NUMERIC(10)
    WS-RETURN-CODE               NUMERIC(4)       * 0=Success, 1=Dup ID, 2=Invalid Age, 99=Error
    WS-RETURN-MSG                CHARACTER(100)

  LOCAL-VIEWS:
    LV-CANDIDATE-DUP             VCANDIDATE-ID-LOOKUP
    LV-CANDIDATE-NEW             VCANDIDATE-ALL

  ACTION-DIAGRAM:
    * ------- Validate ID number not already on file -------
    MOVE 0 TO WS-RETURN-CODE
    MOVE SPACES TO WS-RETURN-MSG

    READ EACH LV-CANDIDATE-DUP
      WHERE LV-CANDIDATE-DUP.ID-NUMBER = WS-ID-NUMBER
      AND   LV-CANDIDATE-DUP.RECORD-STATUS = 'A'
      IMPORT LV-CANDIDATE-DUP
        MOVE 1 TO WS-RETURN-CODE
        MOVE 'CANDIDATE WITH THIS ID NUMBER ALREADY EXISTS' TO WS-RETURN-MSG
        ESCAPE
      END-IMPORT
    END-READ

    IF WS-RETURN-CODE <> 0
      ESCAPE
    END-IF

    * ------- Validate date of birth is in the past -------
    IF WS-DATE-OF-BIRTH >= CURRENT-DATE
      MOVE 2 TO WS-RETURN-CODE
      MOVE 'DATE OF BIRTH MUST BE IN THE PAST' TO WS-RETURN-MSG
      ESCAPE
    END-IF

    * ------- Create candidate record -------
    CREATE LV-CANDIDATE-NEW
      MOVE WS-FIRST-NAME       TO LV-CANDIDATE-NEW.FIRST-NAME
      MOVE WS-LAST-NAME        TO LV-CANDIDATE-NEW.LAST-NAME
      MOVE WS-DATE-OF-BIRTH    TO LV-CANDIDATE-NEW.DATE-OF-BIRTH
      MOVE WS-ID-NUMBER        TO LV-CANDIDATE-NEW.ID-NUMBER
      MOVE WS-ADDRESS-LINE-1   TO LV-CANDIDATE-NEW.ADDRESS-LINE-1
      MOVE WS-ADDRESS-LINE-2   TO LV-CANDIDATE-NEW.ADDRESS-LINE-2
      MOVE WS-CITY             TO LV-CANDIDATE-NEW.CITY
      MOVE WS-STATE-PROVINCE   TO LV-CANDIDATE-NEW.STATE-PROVINCE
      MOVE WS-POSTAL-CODE      TO LV-CANDIDATE-NEW.POSTAL-CODE
      MOVE WS-COUNTRY          TO LV-CANDIDATE-NEW.COUNTRY
      MOVE WS-PHONE-NUMBER     TO LV-CANDIDATE-NEW.PHONE-NUMBER
      MOVE WS-EMAIL-ADDRESS    TO LV-CANDIDATE-NEW.EMAIL-ADDRESS
      MOVE CURRENT-DATE        TO LV-CANDIDATE-NEW.CREATED-DATE
      MOVE 'A'                 TO LV-CANDIDATE-NEW.RECORD-STATUS
    END-CREATE

    MOVE LV-CANDIDATE-NEW.CANDIDATE-ID TO WS-CANDIDATE-ID
    MOVE 0 TO WS-RETURN-CODE
    MOVE 'CANDIDATE CREATED SUCCESSFULLY' TO WS-RETURN-MSG

END-ACTION-BLOCK
