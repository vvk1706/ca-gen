*================================================================*
* Action Block
* Name    : AB-ISSUE-LICENSE
* Process : PROC-VALIDATE-READY-FOR-ISSUE / PROC-GENERATE-LICENSE-NUMBER /
*           PROC-SET-LICENSE-EXPIRY / PROC-CREATE-ISSUED-LICENSE /
*           PROC-UPDATE-APPLICATION-ISSUED
* Desc    : Issues the driver license after all checks and approvals
*           are confirmed. Creates the ISSUED-LICENSE record.
*           Expiry rules:
*             Learner   (L) = 1 year from issue date
*             Probation (P) = 2 years from issue date
*             Open      (O) = 5 years from issue date
*================================================================*

ACTION-BLOCK: AB-ISSUE-LICENSE
  IMPORTS:
    WS-APPLICATION-ID            NUMERIC(10)
    WS-VEHICLE-CLASS             CHARACTER(2)     * A=Motorcycle, B=Light, C=Heavy, D=Bus
    WS-RESTRICTIONS              CHARACTER(200)
    WS-ISSUED-BY-OFFICER         CHARACTER(50)
    WS-ISSUED-BY-AUTHORITY       CHARACTER(50)

  EXPORTS:
    WS-LICENSE-ID                NUMERIC(10)
    WS-LICENSE-NUMBER            CHARACTER(20)
    WS-EXPIRY-DATE               DATE
    WS-RETURN-CODE               NUMERIC(4)       * 0=OK, 1=App Not Found, 2=Not Fully Approved,
                                                  * 3=Invalid Vehicle Class, 99=Error
    WS-RETURN-MSG                CHARACTER(100)

  LOCAL-VIEWS:
    LV-APPLICATION               VAPPLICATION-ALL
    LV-LICENSE-NEW               VLICENSE-CREATE
    LV-APP-UPDATE                VAPPLICATION-STATUS

  LOCAL-WORK-AREAS:
    WA-ISSUE-DATE                DATE
    WA-LICENSE-PREFIX            CHARACTER(3)
    WA-YEARS-VALID               NUMERIC(2)

  ACTION-DIAGRAM:
    MOVE 0 TO WS-RETURN-CODE
    MOVE SPACES TO WS-RETURN-MSG

    * ------- Validate vehicle class -------
    IF WS-VEHICLE-CLASS NOT IN ('A', 'B', 'C', 'D')
      MOVE 3 TO WS-RETURN-CODE
      MOVE 'VEHICLE CLASS MUST BE A, B, C OR D' TO WS-RETURN-MSG
      ESCAPE
    END-IF

    * ------- Read application -------
    READ LV-APPLICATION
      WHERE LV-APPLICATION.APPLICATION-ID = WS-APPLICATION-ID
      WHEN NONE
        MOVE 1 TO WS-RETURN-CODE
        MOVE 'APPLICATION NOT FOUND' TO WS-RETURN-MSG
        ESCAPE
    END-READ

    * ------- Validate all steps are complete -------
    IF LV-APPLICATION.APPLICATION-STATUS <> 'AP'
      MOVE 2 TO WS-RETURN-CODE
      MOVE 'APPLICATION MUST BE FULLY APPROVED (STATUS=AP) BEFORE LICENSE CAN BE ISSUED'
        TO WS-RETURN-MSG
      ESCAPE
    END-IF

    IF LV-APPLICATION.ELIGIBILITY-CHECK-STATUS <> 'P'
      MOVE 2 TO WS-RETURN-CODE
      MOVE 'ELIGIBILITY CHECK HAS NOT BEEN PASSED' TO WS-RETURN-MSG
      ESCAPE
    END-IF

    IF LV-APPLICATION.HISTORY-CHECK-STATUS <> 'P'
      MOVE 2 TO WS-RETURN-CODE
      MOVE 'HISTORY CHECK HAS NOT BEEN PASSED' TO WS-RETURN-MSG
      ESCAPE
    END-IF

    IF LV-APPLICATION.PAYMENT-STATUS NOT IN ('P', 'W')
      MOVE 2 TO WS-RETURN-CODE
      MOVE 'PAYMENT HAS NOT BEEN COMPLETED' TO WS-RETURN-MSG
      ESCAPE
    END-IF

    IF LV-APPLICATION.APPROVAL-1-STATUS <> 'A'
      MOVE 2 TO WS-RETURN-CODE
      MOVE 'FIRST AUTHORITY APPROVAL HAS NOT BEEN GRANTED' TO WS-RETURN-MSG
      ESCAPE
    END-IF

    IF LV-APPLICATION.APPROVAL-2-STATUS <> 'A'
      MOVE 2 TO WS-RETURN-CODE
      MOVE 'SECOND AUTHORITY APPROVAL HAS NOT BEEN GRANTED' TO WS-RETURN-MSG
      ESCAPE
    END-IF

    * ------- Set issue date and calculate expiry -------
    MOVE CURRENT-DATE TO WA-ISSUE-DATE

    IF LV-APPLICATION.LICENSE-TYPE = 'L'
      MOVE 1 TO WA-YEARS-VALID
      MOVE 'LRN' TO WA-LICENSE-PREFIX
    END-IF
    IF LV-APPLICATION.LICENSE-TYPE = 'P'
      MOVE 2 TO WA-YEARS-VALID
      MOVE 'PRB' TO WA-LICENSE-PREFIX
    END-IF
    IF LV-APPLICATION.LICENSE-TYPE = 'O'
      MOVE 5 TO WA-YEARS-VALID
      MOVE 'OPN' TO WA-LICENSE-PREFIX
    END-IF

    ADD WA-YEARS-VALID YEARS TO WA-ISSUE-DATE GIVING WS-EXPIRY-DATE

    * ------- Generate unique license number -------
    CONCATENATE WA-LICENSE-PREFIX
                WS-VEHICLE-CLASS
                LV-APPLICATION.CANDIDATE-ID
                WS-APPLICATION-ID
      INTO WS-LICENSE-NUMBER

    * ------- Create issued license record -------
    CREATE LV-LICENSE-NEW
      MOVE WS-APPLICATION-ID       TO LV-LICENSE-NEW.APPLICATION-ID
      MOVE LV-APPLICATION.CANDIDATE-ID TO LV-LICENSE-NEW.CANDIDATE-ID
      MOVE WS-LICENSE-NUMBER       TO LV-LICENSE-NEW.LICENSE-NUMBER
      MOVE LV-APPLICATION.LICENSE-TYPE TO LV-LICENSE-NEW.LICENSE-TYPE
      MOVE WA-ISSUE-DATE           TO LV-LICENSE-NEW.ISSUE-DATE
      MOVE WS-EXPIRY-DATE          TO LV-LICENSE-NEW.EXPIRY-DATE
      MOVE 'A'                     TO LV-LICENSE-NEW.LICENSE-STATUS
      MOVE WS-VEHICLE-CLASS        TO LV-LICENSE-NEW.VEHICLE-CLASS
      MOVE WS-RESTRICTIONS         TO LV-LICENSE-NEW.RESTRICTIONS
      MOVE 12                      TO LV-LICENSE-NEW.DEMERIT-BALANCE   * start with max
      MOVE WS-ISSUED-BY-AUTHORITY  TO LV-LICENSE-NEW.ISSUED-BY-AUTHORITY
      MOVE WS-ISSUED-BY-OFFICER    TO LV-LICENSE-NEW.ISSUED-BY-OFFICER
    END-CREATE

    MOVE LV-LICENSE-NEW.LICENSE-ID TO WS-LICENSE-ID

    * ------- Update application status to Issued -------
    CHANGE LV-APP-UPDATE
      WHERE LV-APP-UPDATE.APPLICATION-ID = WS-APPLICATION-ID
        MOVE 'IS' TO LV-APP-UPDATE.APPLICATION-STATUS
        MOVE CURRENT-DATE TO LV-APP-UPDATE.LAST-UPDATED-DATE
        MOVE WS-ISSUED-BY-OFFICER TO LV-APP-UPDATE.LAST-UPDATED-BY
    END-CHANGE

    MOVE 0 TO WS-RETURN-CODE
    MOVE 'DRIVER LICENSE ISSUED SUCCESSFULLY' TO WS-RETURN-MSG

END-ACTION-BLOCK
