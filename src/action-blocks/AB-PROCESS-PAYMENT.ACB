*================================================================*
* Action Block
* Name    : AB-PROCESS-PAYMENT
* Process : PROC-CALCULATE-FEE / PROC-RECORD-PAYMENT /
*           PROC-VERIFY-PAYMENT / PROC-GENERATE-RECEIPT
* Desc    : Calculates applicable fee, records payment against
*           the license application and updates status
*================================================================*

ACTION-BLOCK: AB-PROCESS-PAYMENT
  IMPORTS:
    WS-APPLICATION-ID            NUMERIC(10)
    WS-CANDIDATE-ID              NUMERIC(10)
    WS-PAYMENT-METHOD            CHARACTER(2)     * CC, DC, EF, CS, CH
    WS-PAYMENT-REFERENCE         CHARACTER(30)
    WS-PROCESSED-BY              CHARACTER(20)

  EXPORTS:
    WS-PAYMENT-ID                NUMERIC(10)
    WS-FEE-AMOUNT                NUMERIC(10,2)
    WS-RECEIPT-NUMBER            CHARACTER(20)
    WS-RETURN-CODE               NUMERIC(4)       * 0=OK, 1=App Not Found, 2=Fee Not Found,
                                                  * 3=Already Paid, 4=History Not Passed, 99=Err
    WS-RETURN-MSG                CHARACTER(100)

  LOCAL-VIEWS:
    LV-APPLICATION               VAPPLICATION-ALL
    LV-FEE                       VFEE-LOOKUP
    LV-PAYMENT-NEW               VPAYMENT-CREATE
    LV-APP-UPDATE                VAPPLICATION-PAYMENT-UPD

  LOCAL-WORK-AREAS:
    WA-RECEIPT-PREFIX            CHARACTER(5)
    WA-RECEIPT-SEQ               NUMERIC(15)

  ACTION-DIAGRAM:
    MOVE 0 TO WS-RETURN-CODE
    MOVE SPACES TO WS-RETURN-MSG

    * ------- Read application -------
    READ LV-APPLICATION
      WHERE LV-APPLICATION.APPLICATION-ID = WS-APPLICATION-ID
      WHEN NONE
        MOVE 1 TO WS-RETURN-CODE
        MOVE 'APPLICATION NOT FOUND' TO WS-RETURN-MSG
        ESCAPE
    END-READ

    * ------- Check history was passed -------
    IF LV-APPLICATION.HISTORY-CHECK-STATUS <> 'P'
      MOVE 4 TO WS-RETURN-CODE
      MOVE 'HISTORY CHECK MUST BE PASSED BEFORE PAYMENT' TO WS-RETURN-MSG
      ESCAPE
    END-IF

    * ------- Check not already paid -------
    IF LV-APPLICATION.PAYMENT-STATUS = 'P'
      MOVE 3 TO WS-RETURN-CODE
      MOVE 'PAYMENT HAS ALREADY BEEN RECORDED FOR THIS APPLICATION' TO WS-RETURN-MSG
      ESCAPE
    END-IF

    * ------- Look up applicable fee -------
    READ LV-FEE
      WHERE LV-FEE.LICENSE-TYPE   = LV-APPLICATION.LICENSE-TYPE
      AND   LV-FEE.FEE-TYPE       = 'IF'
      AND   LV-FEE.ACTIVE-STATUS  = 'A'
      AND   LV-FEE.EFFECTIVE-DATE <= CURRENT-DATE
      AND   (LV-FEE.EXPIRY-DATE IS NULL OR LV-FEE.EXPIRY-DATE >= CURRENT-DATE)
      WHEN NONE
        MOVE 2 TO WS-RETURN-CODE
        MOVE 'NO ACTIVE FEE SCHEDULE FOUND FOR THIS LICENSE TYPE' TO WS-RETURN-MSG
        ESCAPE
    END-READ

    MOVE LV-FEE.FEE-AMOUNT TO WS-FEE-AMOUNT

    * ------- Generate receipt number -------
    MOVE 'RCP' TO WA-RECEIPT-PREFIX
    MOVE CURRENT-DATE TO WA-RECEIPT-SEQ
    CONCATENATE WA-RECEIPT-PREFIX WA-RECEIPT-SEQ WS-APPLICATION-ID
      INTO WS-RECEIPT-NUMBER

    * ------- Create payment record -------
    CREATE LV-PAYMENT-NEW
      MOVE WS-APPLICATION-ID       TO LV-PAYMENT-NEW.APPLICATION-ID
      MOVE WS-CANDIDATE-ID         TO LV-PAYMENT-NEW.CANDIDATE-ID
      MOVE CURRENT-DATE            TO LV-PAYMENT-NEW.PAYMENT-DATE
      MOVE WS-FEE-AMOUNT           TO LV-PAYMENT-NEW.PAYMENT-AMOUNT
      MOVE WS-PAYMENT-METHOD       TO LV-PAYMENT-NEW.PAYMENT-METHOD
      MOVE WS-PAYMENT-REFERENCE    TO LV-PAYMENT-NEW.PAYMENT-REFERENCE
      MOVE 'S'                     TO LV-PAYMENT-NEW.PAYMENT-STATUS
      MOVE LV-APPLICATION.LICENSE-TYPE TO LV-PAYMENT-NEW.LICENSE-TYPE
      MOVE 'IF'                    TO LV-PAYMENT-NEW.FEE-TYPE
      MOVE WS-RECEIPT-NUMBER       TO LV-PAYMENT-NEW.RECEIPT-NUMBER
      MOVE WS-PROCESSED-BY         TO LV-PAYMENT-NEW.PROCESSED-BY
    END-CREATE

    MOVE LV-PAYMENT-NEW.PAYMENT-ID TO WS-PAYMENT-ID

    * ------- Update application payment status -------
    CHANGE LV-APP-UPDATE
      WHERE LV-APP-UPDATE.APPLICATION-ID = WS-APPLICATION-ID
        MOVE 'P'                   TO LV-APP-UPDATE.PAYMENT-STATUS
        MOVE WS-PAYMENT-REFERENCE  TO LV-APP-UPDATE.PAYMENT-REFERENCE
        MOVE 'PA'                  TO LV-APP-UPDATE.APPLICATION-STATUS
        MOVE CURRENT-DATE          TO LV-APP-UPDATE.LAST-UPDATED-DATE
        MOVE WS-PROCESSED-BY       TO LV-APP-UPDATE.LAST-UPDATED-BY
    END-CHANGE

    MOVE 0 TO WS-RETURN-CODE
    MOVE 'PAYMENT RECORDED SUCCESSFULLY' TO WS-RETURN-MSG

END-ACTION-BLOCK
