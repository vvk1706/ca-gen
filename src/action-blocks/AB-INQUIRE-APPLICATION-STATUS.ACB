*================================================================*
* CA Gen Action Block
* Name    : AB-INQUIRE-APPLICATION-STATUS
* Process : PROC-INQUIRE-APPLICATION-STATUS
* Desc    : Returns full end-to-end status of a license application
*           including all check results, payment and approvals
*================================================================*

ACTION-BLOCK: AB-INQUIRE-APPLICATION-STATUS
  IMPORTS:
    WS-APPLICATION-ID            NUMERIC(10)

  EXPORTS:
    WS-LICENSE-TYPE              CHARACTER(1)
    WS-APP-STATUS                CHARACTER(2)
    WS-APP-STATUS-DESC           CHARACTER(50)
    WS-ELIG-STATUS               CHARACTER(1)
    WS-HIST-STATUS               CHARACTER(1)
    WS-PAY-STATUS                CHARACTER(1)
    WS-APP1-STATUS               CHARACTER(1)
    WS-APP2-STATUS               CHARACTER(1)
    WS-LICENSE-NUMBER            CHARACTER(20)
    WS-RETURN-CODE               NUMERIC(4)
    WS-RETURN-MSG                CHARACTER(100)

  LOCAL-VIEWS:
    LV-APPLICATION               VAPPLICATION-STATUS
    LV-LICENSE                   VLICENSE-SUMMARY

  ACTION-DIAGRAM:
    MOVE 0 TO WS-RETURN-CODE
    MOVE SPACES TO WS-RETURN-MSG

    * ------- Read application -------
    READ LV-APPLICATION
      WHERE LV-APPLICATION.APPLICATION-ID = WS-APPLICATION-ID
      WHEN NONE
        MOVE 1 TO WS-RETURN-CODE
        MOVE 'APPLICATION NOT FOUND' TO WS-RETURN-MSG
        ESCAPE
    END-READ

    * ------- Populate exports -------
    MOVE LV-APPLICATION.LICENSE-TYPE           TO WS-LICENSE-TYPE
    MOVE LV-APPLICATION.APPLICATION-STATUS     TO WS-APP-STATUS
    MOVE LV-APPLICATION.ELIGIBILITY-CHECK-STATUS TO WS-ELIG-STATUS
    MOVE LV-APPLICATION.HISTORY-CHECK-STATUS   TO WS-HIST-STATUS
    MOVE LV-APPLICATION.PAYMENT-STATUS         TO WS-PAY-STATUS
    MOVE LV-APPLICATION.APPROVAL-1-STATUS      TO WS-APP1-STATUS
    MOVE LV-APPLICATION.APPROVAL-2-STATUS      TO WS-APP2-STATUS

    * ------- Derive status description -------
    EVALUATE WS-APP-STATUS
      WHEN 'PE' MOVE 'PENDING - AWAITING ELIGIBILITY CHECK'     TO WS-APP-STATUS-DESC
      WHEN 'EC' MOVE 'ELIGIBILITY CHECKED - AWAITING HISTORY'   TO WS-APP-STATUS-DESC
      WHEN 'HC' MOVE 'HISTORY CHECKED - AWAITING PAYMENT'       TO WS-APP-STATUS-DESC
      WHEN 'PP' MOVE 'PAYMENT PENDING'                          TO WS-APP-STATUS-DESC
      WHEN 'PA' MOVE 'PAYMENT APPROVED - AWAITING AUTH 1'       TO WS-APP-STATUS-DESC
      WHEN 'A1' MOVE 'AWAITING FIRST AUTHORITY APPROVAL'        TO WS-APP-STATUS-DESC
      WHEN 'A2' MOVE 'AWAITING SECOND AUTHORITY APPROVAL'       TO WS-APP-STATUS-DESC
      WHEN 'AP' MOVE 'FULLY APPROVED - READY FOR LICENSE ISSUE' TO WS-APP-STATUS-DESC
      WHEN 'RE' MOVE 'REJECTED'                                 TO WS-APP-STATUS-DESC
      WHEN 'IS' MOVE 'LICENSE ISSUED'                           TO WS-APP-STATUS-DESC
      OTHER     MOVE 'UNKNOWN STATUS'                           TO WS-APP-STATUS-DESC
    END-EVALUATE

    * ------- If issued, retrieve license number -------
    IF WS-APP-STATUS = 'IS'
      READ LV-LICENSE
        WHERE LV-LICENSE.APPLICATION-ID = WS-APPLICATION-ID
        IMPORT LV-LICENSE
          MOVE LV-LICENSE.LICENSE-NUMBER TO WS-LICENSE-NUMBER
        END-IMPORT
      END-READ
    END-IF

    MOVE 0 TO WS-RETURN-CODE
    MOVE 'INQUIRY SUCCESSFUL' TO WS-RETURN-MSG

END-ACTION-BLOCK
