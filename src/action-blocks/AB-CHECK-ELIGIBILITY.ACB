*================================================================*
* CA Gen Action Block
* Name    : AB-CHECK-ELIGIBILITY
* Process : PROC-CHECK-AGE-ELIGIBILITY / PROC-CHECK-ID-VALIDITY /
*           PROC-CHECK-EXISTING-LICENSE / PROC-RECORD-ELIGIBILITY-RESULT
* Desc    : Performs full eligibility check on a license application
*           Rules:
*             Learner  (L) : Minimum age 16
*             Probation(P) : Minimum age 17, must already hold Learner
*             Open     (O) : Minimum age 18, must already hold Probation
*================================================================*

ACTION-BLOCK: AB-CHECK-ELIGIBILITY
  IMPORTS:
    WS-APPLICATION-ID            NUMERIC(10)
    WS-CHECKED-BY                CHARACTER(20)

  EXPORTS:
    WS-ELIGIBILITY-STATUS        CHARACTER(1)     * P=Pass, F=Fail
    WS-RETURN-CODE               NUMERIC(4)       * 0=OK, 1=App Not Found, 99=Error
    WS-RETURN-MSG                CHARACTER(100)

  LOCAL-VIEWS:
    LV-APPLICATION               VAPPLICATION-ALL
    LV-CANDIDATE                 VCANDIDATE-ELIGIBILITY
    LV-EXISTING-LICENSE          VLICENSE-SUMMARY
    LV-APP-UPDATE                VAPPLICATION-ELIGIBILITY-UPD

  LOCAL-WORK-AREAS:
    WA-CANDIDATE-AGE             NUMERIC(3)
    WA-ELIG-FAIL-REASON          CHARACTER(200)
    WA-FAIL-FLAG                 CHARACTER(1)
    WA-REQUIRED-PREV-TYPE        CHARACTER(1)

  ACTION-DIAGRAM:
    MOVE 0 TO WS-RETURN-CODE
    MOVE SPACES TO WS-RETURN-MSG
    MOVE 'N' TO WA-FAIL-FLAG
    MOVE SPACES TO WA-ELIG-FAIL-REASON

    * ------- Read application -------
    READ LV-APPLICATION
      WHERE LV-APPLICATION.APPLICATION-ID = WS-APPLICATION-ID
      WHEN NONE
        MOVE 1 TO WS-RETURN-CODE
        MOVE 'APPLICATION NOT FOUND' TO WS-RETURN-MSG
        ESCAPE
    END-READ

    * ------- Read candidate -------
    READ LV-CANDIDATE
      WHERE LV-CANDIDATE.CANDIDATE-ID = LV-APPLICATION.CANDIDATE-ID
      WHEN NONE
        MOVE 99 TO WS-RETURN-CODE
        MOVE 'CANDIDATE RECORD NOT FOUND' TO WS-RETURN-MSG
        ESCAPE
    END-READ

    * ------- Calculate age -------
    MOVE (CURRENT-DATE - LV-CANDIDATE.DATE-OF-BIRTH) / 365 TO WA-CANDIDATE-AGE

    * ------- Age check per license type -------
    IF LV-APPLICATION.LICENSE-TYPE = 'L'
      IF WA-CANDIDATE-AGE < 16
        MOVE 'Y' TO WA-FAIL-FLAG
        MOVE 'CANDIDATE MUST BE AT LEAST 16 YEARS OLD FOR LEARNER LICENSE'
          TO WA-ELIG-FAIL-REASON
      END-IF
    END-IF

    IF LV-APPLICATION.LICENSE-TYPE = 'P'
      IF WA-CANDIDATE-AGE < 17
        MOVE 'Y' TO WA-FAIL-FLAG
        MOVE 'CANDIDATE MUST BE AT LEAST 17 YEARS OLD FOR PROBATION LICENSE'
          TO WA-ELIG-FAIL-REASON
      END-IF
      MOVE 'L' TO WA-REQUIRED-PREV-TYPE
    END-IF

    IF LV-APPLICATION.LICENSE-TYPE = 'O'
      IF WA-CANDIDATE-AGE < 18
        MOVE 'Y' TO WA-FAIL-FLAG
        MOVE 'CANDIDATE MUST BE AT LEAST 18 YEARS OLD FOR OPEN LICENSE'
          TO WA-ELIG-FAIL-REASON
      END-IF
      MOVE 'P' TO WA-REQUIRED-PREV-TYPE
    END-IF

    * ------- Check upgrade path: P requires L, O requires P -------
    IF LV-APPLICATION.LICENSE-TYPE IN ('P', 'O') AND WA-FAIL-FLAG = 'N'
      READ EACH LV-EXISTING-LICENSE
        WHERE LV-EXISTING-LICENSE.CANDIDATE-ID  = LV-APPLICATION.CANDIDATE-ID
        AND   LV-EXISTING-LICENSE.LICENSE-TYPE  = WA-REQUIRED-PREV-TYPE
        AND   LV-EXISTING-LICENSE.LICENSE-STATUS = 'A'
        IMPORT LV-EXISTING-LICENSE
          * Found valid prior license — upgrade path satisfied
          ESCAPE
        END-IMPORT
        * If here no active prior license found
        MOVE 'Y' TO WA-FAIL-FLAG
        IF LV-APPLICATION.LICENSE-TYPE = 'P'
          MOVE 'CANDIDATE MUST HOLD AN ACTIVE LEARNER LICENSE TO APPLY FOR PROBATION'
            TO WA-ELIG-FAIL-REASON
        ELSE
          MOVE 'CANDIDATE MUST HOLD AN ACTIVE PROBATION LICENSE TO APPLY FOR OPEN'
            TO WA-ELIG-FAIL-REASON
        END-IF
      END-READ
    END-IF

    * ------- Set result and update application -------
    IF WA-FAIL-FLAG = 'Y'
      MOVE 'F' TO WS-ELIGIBILITY-STATUS
    ELSE
      MOVE 'P' TO WS-ELIGIBILITY-STATUS
    END-IF

    CHANGE LV-APP-UPDATE
      WHERE LV-APP-UPDATE.APPLICATION-ID = WS-APPLICATION-ID
        MOVE WS-ELIGIBILITY-STATUS   TO LV-APP-UPDATE.ELIGIBILITY-CHECK-STATUS
        MOVE CURRENT-DATE            TO LV-APP-UPDATE.ELIGIBILITY-CHECK-DATE
        MOVE WA-ELIG-FAIL-REASON     TO LV-APP-UPDATE.ELIGIBILITY-CHECK-NOTES
        IF WS-ELIGIBILITY-STATUS = 'P'
          MOVE 'EC' TO LV-APP-UPDATE.APPLICATION-STATUS
        ELSE
          MOVE 'RE' TO LV-APP-UPDATE.APPLICATION-STATUS
        END-IF
        MOVE CURRENT-DATE            TO LV-APP-UPDATE.LAST-UPDATED-DATE
        MOVE WS-CHECKED-BY           TO LV-APP-UPDATE.LAST-UPDATED-BY
    END-CHANGE

    MOVE 0 TO WS-RETURN-CODE
    IF WS-ELIGIBILITY-STATUS = 'P'
      MOVE 'ELIGIBILITY CHECK PASSED' TO WS-RETURN-MSG
    ELSE
      MOVE WA-ELIG-FAIL-REASON TO WS-RETURN-MSG
    END-IF

END-ACTION-BLOCK
