*================================================================*
* Screen Map Definition
* Screen  : SCR-ELIGIBILITY-CHECK
* Process : PROC-CHECK-AGE-ELIGIBILITY / PROC-RECORD-ELIGIBILITY-RESULT
* Desc    : Screen for performing and recording eligibility check
*================================================================*

SCREEN-MAP: SCR-ELIGIBILITY-CHECK
  TITLE:    'DRIVER LICENSE SYSTEM - ELIGIBILITY CHECK'
  SIZE:     24 ROWS x 80 COLUMNS
  TYPE:     DATA-ENTRY

  HEADER:
    ROW 1  COL 1   LITERAL  'DLIS                  ELIGIBILITY CHECK                '
    ROW 1  COL 60  LITERAL  'DATE: '
    ROW 1  COL 66  FIELD    CURRENT-DATE          OUTPUT  PIC 99/99/9999
    ROW 2  COL 1   LITERAL  REPEAT '-' 80

  BODY:
    ROW 4  COL 2   LITERAL  'APPLICATION ID  : '
    ROW 4  COL 20  FIELD    APPLICATION-ID        INPUT    PIC Z(9)9   NAME(FLD-APP-ID)
                                                  REQUIRED

    ROW 5  COL 2   LITERAL  'CANDIDATE NAME  : '
    ROW 5  COL 20  FIELD    CAND-FULL-NAME        OUTPUT   PIC X(60)   NAME(FLD-CAND-NAME)

    ROW 6  COL 2   LITERAL  'DATE OF BIRTH   : '
    ROW 6  COL 20  FIELD    DATE-OF-BIRTH         OUTPUT   PIC 99/99/9999  NAME(FLD-DOB)

    ROW 7  COL 2   LITERAL  'CALCULATED AGE  : '
    ROW 7  COL 20  FIELD    CANDIDATE-AGE         OUTPUT   PIC ZZ9         NAME(FLD-AGE)

    ROW 8  COL 2   LITERAL  'LICENSE TYPE    : '
    ROW 8  COL 20  FIELD    LICENSE-TYPE          OUTPUT   PIC X(1)    NAME(FLD-LIC-TYPE)
    ROW 8  COL 22  FIELD    LICENSE-TYPE-DESC     OUTPUT   PIC X(20)   NAME(FLD-LIC-DESC)

    ROW 9  COL 2   LITERAL  'MIN AGE REQUIRED: '
    ROW 9  COL 20  FIELD    MIN-AGE-REQUIRED      OUTPUT   PIC ZZ9         NAME(FLD-MINAGE)

    ROW 10 COL 2   LITERAL  'PRIOR LICENSE   : '
    ROW 10 COL 20  FIELD    PRIOR-LICENSE-STATUS  OUTPUT   PIC X(30)   NAME(FLD-PRIOR)

    ROW 12 COL 2   LITERAL  'CHECK STATUS    : '
    ROW 12 COL 20  FIELD    ELIGIBILITY-STATUS    OUTPUT   PIC X(1)    NAME(FLD-ELIG-STAT)
    ROW 12 COL 22  FIELD    ELIGIBILITY-STATUS-DESC OUTPUT PIC X(30)   NAME(FLD-ELIG-DESC)

    ROW 13 COL 2   LITERAL  'CHECK NOTES     : '
    ROW 13 COL 20  FIELD    ELIGIBILITY-NOTES     OUTPUT   PIC X(60)   NAME(FLD-ELIG-NOTES)

    ROW 15 COL 2   LITERAL  'CHECKED BY      : '
    ROW 15 COL 20  FIELD    CHECKED-BY            INPUT    PIC X(20)   NAME(FLD-CHKBY)
                                                  REQUIRED

  MESSAGES:
    ROW 22 COL 2   FIELD    MSG-TEXT              OUTPUT  PIC X(76)  NAME(FLD-MSG)
                                                  COLOR(GREEN)

  FOOTER:
    ROW 23 COL 1   LITERAL  REPEAT '-' 80
    ROW 24 COL 2   LITERAL  'F1=RUN CHECK  F3=LOOKUP APP  F12=EXIT'

  PFKEY-ACTIONS:
    PF1  TRIGGER: TRG-ELIGIBILITY-RUN
    PF3  TRIGGER: TRG-APPLICATION-LOOKUP
    PF12 RETURN

END-SCREEN-MAP
