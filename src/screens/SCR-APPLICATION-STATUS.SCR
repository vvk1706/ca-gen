*================================================================*
* Screen Map Definition
* Screen  : SCR-APPLICATION-STATUS
* Process : PROC-INQUIRE-APPLICATION-STATUS
* Desc    : Inquiry screen showing full end-to-end status of
*           a license application
*================================================================*

SCREEN-MAP: SCR-APPLICATION-STATUS
  TITLE:    'DRIVER LICENSE SYSTEM - APPLICATION STATUS INQUIRY'
  SIZE:     24 ROWS x 80 COLUMNS
  TYPE:     INQUIRY

  HEADER:
    ROW 1  COL 1   LITERAL  'DLIS           APPLICATION STATUS INQUIRY              '
    ROW 1  COL 60  LITERAL  'DATE: '
    ROW 1  COL 66  FIELD    CURRENT-DATE          OUTPUT  PIC 99/99/9999
    ROW 2  COL 1   LITERAL  REPEAT '-' 80

  BODY:
    ROW 4  COL 2   LITERAL  'APPLICATION ID  : '
    ROW 4  COL 20  FIELD    APPLICATION-ID        INPUT    PIC Z(9)9   NAME(FLD-APP-ID)
                                                  REQUIRED

    ROW 5  COL 2   LITERAL  'LICENSE TYPE    : '
    ROW 5  COL 20  FIELD    LICENSE-TYPE          OUTPUT   PIC X(1)    NAME(FLD-LIC-TYPE)
    ROW 5  COL 22  FIELD    LICENSE-TYPE-DESC     OUTPUT   PIC X(20)   NAME(FLD-LIC-DESC)

    ROW 6  COL 2   LITERAL  'OVERALL STATUS  : '
    ROW 6  COL 20  FIELD    APPLICATION-STATUS    OUTPUT   PIC X(2)    NAME(FLD-APP-STAT)
    ROW 6  COL 23  FIELD    APP-STATUS-DESC       OUTPUT   PIC X(50)   NAME(FLD-APP-DESC)

    ROW 7  COL 1   LITERAL  REPEAT '-' 80

    ROW 8  COL 2   LITERAL  'STEP                   STATUS  DATE        NOTES'
    ROW 9  COL 2   LITERAL  REPEAT '-' 76

    ROW 10 COL 2   LITERAL  '1. ELIGIBILITY CHECK : '
    ROW 10 COL 25  FIELD    ELIG-STATUS           OUTPUT   PIC X(6)    NAME(FLD-ELIG)
    ROW 10 COL 32  FIELD    ELIG-DATE             OUTPUT   PIC 99/99/9999 NAME(FLD-ELIG-DT)
    ROW 10 COL 43  FIELD    ELIG-NOTES            OUTPUT   PIC X(30)   NAME(FLD-ELIG-N)

    ROW 11 COL 2   LITERAL  '2. HISTORY CHECK    : '
    ROW 11 COL 25  FIELD    HIST-STATUS           OUTPUT   PIC X(6)    NAME(FLD-HIST)
    ROW 11 COL 32  FIELD    HIST-DATE             OUTPUT   PIC 99/99/9999 NAME(FLD-HIST-DT)
    ROW 11 COL 43  FIELD    HIST-NOTES            OUTPUT   PIC X(30)   NAME(FLD-HIST-N)

    ROW 12 COL 2   LITERAL  '3. PAYMENT          : '
    ROW 12 COL 25  FIELD    PAYMENT-STATUS        OUTPUT   PIC X(6)    NAME(FLD-PAY)
    ROW 12 COL 32  FIELD    PAYMENT-REF           OUTPUT   PIC X(20)   NAME(FLD-PAY-REF)

    ROW 13 COL 2   LITERAL  '4. FIRST APPROVAL   : '
    ROW 13 COL 25  FIELD    APPROVAL-1-STATUS     OUTPUT   PIC X(6)    NAME(FLD-AUTH1)
    ROW 13 COL 32  FIELD    APPROVAL-1-DATE       OUTPUT   PIC 99/99/9999 NAME(FLD-A1-DT)
    ROW 13 COL 43  FIELD    APPROVAL-1-AUTHORITY  OUTPUT   PIC X(30)   NAME(FLD-A1-AUTH)

    ROW 14 COL 2   LITERAL  '5. SECOND APPROVAL  : '
    ROW 14 COL 25  FIELD    APPROVAL-2-STATUS     OUTPUT   PIC X(6)    NAME(FLD-AUTH2)
    ROW 14 COL 32  FIELD    APPROVAL-2-DATE       OUTPUT   PIC 99/99/9999 NAME(FLD-A2-DT)
    ROW 14 COL 43  FIELD    APPROVAL-2-AUTHORITY  OUTPUT   PIC X(30)   NAME(FLD-A2-AUTH)

    ROW 15 COL 1   LITERAL  REPEAT '-' 80

    ROW 16 COL 2   LITERAL  '6. LICENSE ISSUED   : '
    ROW 16 COL 25  FIELD    LICENSE-ISSUED-FLAG   OUTPUT   PIC X(6)    NAME(FLD-LIC-FLAG)

    ROW 17 COL 2   LITERAL  '   LICENSE NUMBER   : '
    ROW 17 COL 25  FIELD    LICENSE-NUMBER        OUTPUT   PIC X(20)   NAME(FLD-LIC-NUM)

    ROW 18 COL 2   LITERAL  '   EXPIRY DATE      : '
    ROW 18 COL 25  FIELD    EXPIRY-DATE           OUTPUT   PIC 99/99/9999 NAME(FLD-EXPIRY)

  MESSAGES:
    ROW 22 COL 2   FIELD    MSG-TEXT              OUTPUT  PIC X(76)  NAME(FLD-MSG)

  FOOTER:
    ROW 23 COL 1   LITERAL  REPEAT '-' 80
    ROW 24 COL 2   LITERAL  'ENTER=INQUIRE  F12=EXIT'

  PFKEY-ACTIONS:
    ENTER TRIGGER: TRG-STATUS-INQUIRE
    PF12  RETURN

END-SCREEN-MAP
