*================================================================*
* CA Gen Screen Map Definition
* Screen  : SCR-MAIN-MENU
* Desc    : Main menu for Driver License Issuance System (DLIS)
*================================================================*

SCREEN-MAP: SCR-MAIN-MENU
  TITLE:    'DRIVER LICENSE ISSUANCE SYSTEM - MAIN MENU'
  SIZE:     24 ROWS x 80 COLUMNS
  TYPE:     MENU

  HEADER:
    ROW 1  COL 1   LITERAL  REPEAT '*' 80
    ROW 2  COL 20  LITERAL  'DRIVER LICENSE ISSUANCE SYSTEM (DLIS)'
    ROW 3  COL 1   LITERAL  REPEAT '*' 80
    ROW 4  COL 60  LITERAL  'DATE: '
    ROW 4  COL 66  FIELD    CURRENT-DATE          OUTPUT  PIC 99/99/9999

  BODY:
    ROW 6  COL 5   LITERAL  '--- CANDIDATE ---'
    ROW 7  COL 7   LITERAL  '1.  CANDIDATE MAINTENANCE'
    ROW 8  COL 7   LITERAL  '2.  CANDIDATE INQUIRY'

    ROW 10 COL 5   LITERAL  '--- APPLICATION ---'
    ROW 11 COL 7   LITERAL  '3.  NEW LICENSE APPLICATION'
    ROW 12 COL 7   LITERAL  '4.  APPLICATION STATUS INQUIRY'

    ROW 14 COL 5   LITERAL  '--- PROCESSING ---'
    ROW 15 COL 7   LITERAL  '5.  ELIGIBILITY CHECK'
    ROW 16 COL 7   LITERAL  '6.  DRIVING HISTORY CHECK'
    ROW 17 COL 7   LITERAL  '7.  PAYMENT ENTRY'

    ROW 19 COL 5   LITERAL  '--- APPROVALS ---'
    ROW 20 COL 7   LITERAL  '8.  FIRST AUTHORITY APPROVAL'
    ROW 21 COL 7   LITERAL  '9.  SECOND AUTHORITY APPROVAL'

    ROW 22 COL 5   LITERAL  '10. ISSUE LICENSE'

    ROW 5  COL 45  LITERAL  '--- LICENSE INQUIRY ---'
    ROW 6  COL 47  LITERAL  '11. INQUIRE ISSUED LICENSE'
    ROW 7  COL 47  LITERAL  '12. SUSPEND LICENSE'
    ROW 8  COL 47  LITERAL  '13. REVOKE LICENSE'

    ROW 10 COL 45  LITERAL  '--- MAINTENANCE ---'
    ROW 11 COL 47  LITERAL  '14. AUTHORITY USER MAINTENANCE'
    ROW 12 COL 47  LITERAL  '15. FEE SCHEDULE MAINTENANCE'

    ROW 15 COL 45  LITERAL  'SELECT OPTION: '
    ROW 15 COL 61  FIELD    MENU-OPTION           INPUT    PIC X(2)    NAME(FLD-OPT)

  MESSAGES:
    ROW 23 COL 2   FIELD    MSG-TEXT              OUTPUT  PIC X(76)  NAME(FLD-MSG)

  FOOTER:
    ROW 24 COL 2   LITERAL  'ENTER=SELECT  F12=EXIT'

  PFKEY-ACTIONS:
    ENTER TRIGGER: TRG-MENU-SELECT
    PF12  RETURN

  MENU-ROUTING:
    OPTION '1'  TRANSFER-TO SCR-CANDIDATE-MAINT
    OPTION '2'  TRANSFER-TO SCR-CANDIDATE-MAINT
    OPTION '3'  TRANSFER-TO SCR-APPLICATION-ENTRY
    OPTION '4'  TRANSFER-TO SCR-APPLICATION-STATUS
    OPTION '5'  TRANSFER-TO SCR-ELIGIBILITY-CHECK
    OPTION '6'  TRANSFER-TO SCR-HISTORY-CHECK
    OPTION '7'  TRANSFER-TO SCR-PAYMENT-ENTRY
    OPTION '8'  TRANSFER-TO SCR-APPROVAL-AUTH1
    OPTION '9'  TRANSFER-TO SCR-APPROVAL-AUTH2
    OPTION '10' TRANSFER-TO SCR-LICENSE-ISSUE

END-SCREEN-MAP
