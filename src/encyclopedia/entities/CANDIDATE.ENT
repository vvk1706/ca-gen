*================================================================*
* CA Gen Encyclopedia - Entity Definition
* Entity  : CANDIDATE
* Desc    : Represents a person applying for a driver license
*================================================================*

ENTITY: CANDIDATE
  IDENTIFIER:
    CANDIDATE-ID                 NUMERIC(10)       NOT NULL

  ATTRIBUTES:
    FIRST-NAME                   CHARACTER(30)     NOT NULL
    LAST-NAME                    CHARACTER(30)     NOT NULL
    DATE-OF-BIRTH                DATE              NOT NULL
    ID-NUMBER                    CHARACTER(20)     NOT NULL   * National ID / Passport
    ADDRESS-LINE-1               CHARACTER(50)     NOT NULL
    ADDRESS-LINE-2               CHARACTER(50)
    CITY                         CHARACTER(30)     NOT NULL
    STATE-PROVINCE               CHARACTER(30)     NOT NULL
    POSTAL-CODE                  CHARACTER(10)     NOT NULL
    COUNTRY                      CHARACTER(30)     NOT NULL
    PHONE-NUMBER                 CHARACTER(15)
    EMAIL-ADDRESS                CHARACTER(60)
    CREATED-DATE                 DATE              NOT NULL
    RECORD-STATUS                CHARACTER(1)      NOT NULL   * A=Active, I=Inactive

  RELATIONSHIPS:
    HAS-ONE-OR-MORE              LICENSE-APPLICATION
    HAS-ZERO-OR-MORE             DRIVING-HISTORY
    HAS-ZERO-OR-MORE             PAYMENT

  VALIDATION:
    DATE-OF-BIRTH < CURRENT-DATE
    RECORD-STATUS IN ('A', 'I')
