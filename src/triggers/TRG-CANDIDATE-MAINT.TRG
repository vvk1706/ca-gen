*================================================================*
* Trigger Definitions
* Subject : CANDIDATE MAINTENANCE screen triggers
* Screen  : SCR-CANDIDATE-MAINT
*================================================================*

*----------------------------------------------------------------*
* TRIGGER: TRG-CANDIDATE-CREATE
* Event   : PF1 pressed on SCR-CANDIDATE-MAINT
* Desc    : Calls AB-CREATE-CANDIDATE with screen field values
*----------------------------------------------------------------*
TRIGGER: TRG-CANDIDATE-CREATE
  SCREEN: SCR-CANDIDATE-MAINT
  EVENT:  PF1

  ACTION-DIAGRAM:
    MOVE FLD-FNAME      TO WS-FIRST-NAME
    MOVE FLD-LNAME      TO WS-LAST-NAME
    MOVE FLD-DOB        TO WS-DATE-OF-BIRTH
    MOVE FLD-IDNO       TO WS-ID-NUMBER
    MOVE FLD-ADDR1      TO WS-ADDRESS-LINE-1
    MOVE FLD-ADDR2      TO WS-ADDRESS-LINE-2
    MOVE FLD-CITY       TO WS-CITY
    MOVE FLD-STATE      TO WS-STATE-PROVINCE
    MOVE FLD-POSTCD     TO WS-POSTAL-CODE
    MOVE FLD-CNTRY      TO WS-COUNTRY
    MOVE FLD-PHONE      TO WS-PHONE-NUMBER
    MOVE FLD-EMAIL      TO WS-EMAIL-ADDRESS
    MOVE USER-ID        TO WS-CREATED-BY

    USE AB-CREATE-CANDIDATE

    IF WS-RETURN-CODE = 0
      MOVE WS-CANDIDATE-ID TO FLD-CAND-ID
      MOVE 'GREEN'         TO FLD-MSG COLOR
    ELSE
      MOVE 'RED'           TO FLD-MSG COLOR
    END-IF
    MOVE WS-RETURN-MSG TO FLD-MSG

END-TRIGGER

*----------------------------------------------------------------*
* TRIGGER: TRG-CANDIDATE-UPDATE
* Event   : PF2 pressed on SCR-CANDIDATE-MAINT
*----------------------------------------------------------------*
TRIGGER: TRG-CANDIDATE-UPDATE
  SCREEN: SCR-CANDIDATE-MAINT
  EVENT:  PF2

  ACTION-DIAGRAM:
    * Validate candidate ID is populated
    IF FLD-CAND-ID IS EMPTY
      MOVE 'CANDIDATE ID IS REQUIRED FOR UPDATE' TO FLD-MSG
      MOVE 'RED' TO FLD-MSG COLOR
      ESCAPE
    END-IF

    CHANGE VCANDIDATE-ALL
      WHERE CANDIDATE-ID = FLD-CAND-ID
        MOVE FLD-FNAME  TO FIRST-NAME
        MOVE FLD-LNAME  TO LAST-NAME
        MOVE FLD-DOB    TO DATE-OF-BIRTH
        MOVE FLD-ADDR1  TO ADDRESS-LINE-1
        MOVE FLD-ADDR2  TO ADDRESS-LINE-2
        MOVE FLD-CITY   TO CITY
        MOVE FLD-STATE  TO STATE-PROVINCE
        MOVE FLD-POSTCD TO POSTAL-CODE
        MOVE FLD-CNTRY  TO COUNTRY
        MOVE FLD-PHONE  TO PHONE-NUMBER
        MOVE FLD-EMAIL  TO EMAIL-ADDRESS
        MOVE FLD-STATUS TO RECORD-STATUS
      WHEN NONE
        MOVE 'CANDIDATE NOT FOUND' TO FLD-MSG
        ESCAPE
    END-CHANGE

    MOVE 'CANDIDATE UPDATED SUCCESSFULLY' TO FLD-MSG
    MOVE 'GREEN' TO FLD-MSG COLOR

END-TRIGGER

*----------------------------------------------------------------*
* TRIGGER: TRG-CANDIDATE-INQUIRE
* Event   : PF3 pressed on SCR-CANDIDATE-MAINT
*----------------------------------------------------------------*
TRIGGER: TRG-CANDIDATE-INQUIRE
  SCREEN: SCR-CANDIDATE-MAINT
  EVENT:  PF3

  ACTION-DIAGRAM:
    IF FLD-CAND-ID IS EMPTY AND FLD-IDNO IS EMPTY
      MOVE 'ENTER CANDIDATE ID OR NATIONAL ID NUMBER' TO FLD-MSG
      ESCAPE
    END-IF

    READ VCANDIDATE-ALL
      WHERE CANDIDATE-ID = FLD-CAND-ID
         OR ID-NUMBER    = FLD-IDNO
      IMPORT VCANDIDATE-ALL
        MOVE CANDIDATE-ID     TO FLD-CAND-ID
        MOVE FIRST-NAME       TO FLD-FNAME
        MOVE LAST-NAME        TO FLD-LNAME
        MOVE DATE-OF-BIRTH    TO FLD-DOB
        MOVE ID-NUMBER        TO FLD-IDNO
        MOVE ADDRESS-LINE-1   TO FLD-ADDR1
        MOVE ADDRESS-LINE-2   TO FLD-ADDR2
        MOVE CITY             TO FLD-CITY
        MOVE STATE-PROVINCE   TO FLD-STATE
        MOVE POSTAL-CODE      TO FLD-POSTCD
        MOVE COUNTRY          TO FLD-CNTRY
        MOVE PHONE-NUMBER     TO FLD-PHONE
        MOVE EMAIL-ADDRESS    TO FLD-EMAIL
        MOVE RECORD-STATUS    TO FLD-STATUS
        MOVE 'CANDIDATE FOUND' TO FLD-MSG
      END-IMPORT
      WHEN NONE
        MOVE 'CANDIDATE NOT FOUND' TO FLD-MSG
        MOVE 'RED' TO FLD-MSG COLOR
    END-READ

END-TRIGGER

*----------------------------------------------------------------*
* TRIGGER: TRG-CANDIDATE-DEACTIVATE
* Event   : PF4 pressed on SCR-CANDIDATE-MAINT
*----------------------------------------------------------------*
TRIGGER: TRG-CANDIDATE-DEACTIVATE
  SCREEN: SCR-CANDIDATE-MAINT
  EVENT:  PF4

  ACTION-DIAGRAM:
    IF FLD-CAND-ID IS EMPTY
      MOVE 'CANDIDATE ID IS REQUIRED TO DEACTIVATE' TO FLD-MSG
      ESCAPE
    END-IF

    CHANGE VCANDIDATE-ALL
      WHERE CANDIDATE-ID = FLD-CAND-ID
        MOVE 'I' TO RECORD-STATUS
      WHEN NONE
        MOVE 'CANDIDATE NOT FOUND' TO FLD-MSG
        ESCAPE
    END-CHANGE

    MOVE 'I' TO FLD-STATUS
    MOVE 'CANDIDATE DEACTIVATED' TO FLD-MSG

END-TRIGGER

END-TRIGGERS: SCR-CANDIDATE-MAINT
